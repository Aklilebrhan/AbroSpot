# ==============================================================
# ABROSPOT PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================

# Core Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abrospot?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="abrospot"
POSTGRES_PORT=5432

REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# JWT & Inter-Service Security
JWT_SECRET="abrospot-super-secure-jwt-secret-key-2026-change-in-production"
INTERNAL_API_SECRET="abrospot-internal-secret-token"

# Ports
API_PORT=4000
WEB_PORT=3000
AI_PORT=8000

# Next.js Public Endpoints
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --------------------------------------------------------------
# SOCIAL MEDIA INGESTION CREDENTIALS (OPTIONAL IN DEV / SIMULATED)
# --------------------------------------------------------------

# 1. Telegram MTProto (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_NAME="abrospot_tg_session"

# 2. X (Twitter) API v2
X_BEARER_TOKEN=

# 3. Meta / Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# 4. TikTok API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 5. LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 6. Optional Multimodal Vision / LLM API Fallbacks
GEMINI_API_KEY=
OPENAI_API_KEY=
